# ---- Core ----
# Long random string. Signs admin sessions, order links and one-tap admin links.
AUTH_SECRET=change-me-to-a-long-random-string
# Public URL of the site (used in emails / WhatsApp links / payment callbacks)
APP_URL=http://localhost:3000

# ---- Database ----
# Leave empty locally to use embedded PGlite (stored in .data/pglite).
# Production: Supabase connection string (Transaction pooler, port 6543).
DATABASE_URL=
# Supabase session pooler (port 5432), used only by `npm run db:migrate`
MIGRATION_DATABASE_URL=

# ---- First admin (used by `npm run db:seed`) ----
ADMIN_EMAIL=admin@belladerma.test
ADMIN_PASSWORD=changeme123

# ---- Payments ----
# mock | paystack | bachs   (mock = local demo, never in production)
PAYMENT_PROVIDER=mock
PAYSTACK_SECRET_KEY=
BACHS_SECRET_KEY=
BACHS_WEBHOOK_SECRET=

# ---- Email (Resend) ----  empty = print to console
RESEND_API_KEY=
EMAIL_FROM=Belladerma <orders@belladerma.com.ng>

# ---- WhatsApp Cloud API (Meta) ----  empty = skip WhatsApp, email only
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TEMPLATE_LANG=en

# ---- File storage ----  empty = local disk (.data/uploads)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET=belladerma
# Receipts go here; created automatically (private) on first upload
SUPABASE_PRIVATE_BUCKET=belladerma-private

# ---- Cron ----
CRON_SECRET=change-me

# Hosted demo only: let PAYMENT_PROVIDER=mock work on a live URL (never for real sales)
ALLOW_MOCK_PAYMENTS=

# Local dev uses the embedded DB even when DATABASE_URL is set. 1 = use Supabase in `npm run dev`
USE_REMOTE_DB_IN_DEV=
